{
    "name": "@s111310504/cf-edge-limiter",
    "version": "1.0.0",
    "description": "Zero-dependency rate limiter compatible with Cloudflare Workers and Node.js",
    "keywords": [
        "cloudflare",
        "workers",
        "nodejs",
        "rate-limit",
        "edge"
    ],
    "license": "MIT",
    "author": "Your Name",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}